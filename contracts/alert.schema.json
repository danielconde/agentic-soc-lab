{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-soc-lab.local/schemas/alert.schema.json",
  "title": "Agentic SOC Alert",
  "description": "Canonical alert format used internally by Agentic SOC Lab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "title",
    "description",
    "severity",
    "category",
    "source",
    "event_time",
    "entities",
    "iocs",
    "raw_alert"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "identity",
        "endpoint",
        "network",
        "email",
        "cloud",
        "data",
        "application",
        "other",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "product"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string"
        }
      }
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users",
        "hosts",
        "ips"
      ],
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "role"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "source",
                  "destination",
                  "related",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "iocs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "raw_alert": {
      "type": "object"
    }
  }
}