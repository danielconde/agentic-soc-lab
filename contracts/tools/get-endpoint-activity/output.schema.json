{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-soc-lab.local/schemas/tools/get-endpoint-activity/output.schema.json",
  "title": "get_endpoint_activity Output",
  "description": "Canonical output contract for the get_endpoint_activity investigation tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_version",
    "status",
    "query",
    "result_count",
    "events",
    "error"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "const": "get_endpoint_activity"
    },
    "tool_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "error"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "time_range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "result_count": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "host",
          "event_type",
          "severity"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "process": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "command_line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent_process": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "network": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "destination_ip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "destination_port": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}