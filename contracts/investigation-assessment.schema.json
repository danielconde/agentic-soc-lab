{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-soc-lab.local/schemas/investigation-assessment.schema.json",
  "title": "Agentic SOC Investigation Assessment",
  "description": "Canonical evidence-based assessment produced after investigation tools have executed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_version",
    "alert_id",
    "summary",
    "observed_evidence",
    "correlations",
    "hypotheses",
    "risk_assessment",
    "verdict",
    "confidence",
    "remaining_gaps",
    "recommended_next_actions"
  ],
  "properties": {
    "assessment_version": {
      "type": "string",
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "observed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "field",
          "value"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "evidence_sources"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reasoning"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "benign",
        "suspicious",
        "malicious",
        "inconclusive"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}