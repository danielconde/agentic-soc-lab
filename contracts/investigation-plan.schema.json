{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-soc-lab.local/schemas/investigation-plan.schema.json",
  "title": "Agentic SOC Investigation Plan",
  "description": "Canonical investigation plan generated from a validated initial SOC analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "alert_id",
    "objective",
    "investigation_steps"
  ],
  "properties": {
    "plan_version": {
      "type": "string",
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "investigation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "priority",
          "purpose",
          "tool",
          "parameters",
          "evidence_target"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^step-[0-9]+$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "enum": [
              "get_signins",
              "get_ip_reputation",
              "get_endpoint_activity",
              "get_user_activity",
              "get_mail_activity"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "evidence_target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}